[mysqld]
user                            = mysql
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/slow-query.log
character-set-server            = utf8mb4
default-storage-engine          = InnoDB
thread_stack                    = {{ mysql_tuning.thread_stack }}
key_buffer_size                 = {{ mysql_tuning.key_buffer_size }}
sort_buffer_size                = {{ mysql_tuning.sort_buffer_size }}
read_buffer_size                = {{ mysql_tuning.read_buffer_size }}
read_rnd_buffer_size            = {{ mysql_tuning.read_rnd_buffer_size }}
join_buffer_size                = {{ mysql_tuning.join_buffer_size }}
net_buffer_length               = {{ mysql_tuning.net_buffer_length }}
innodb_data_home_dir            = /var/lib/mysql
innodb_log_group_home_dir       = /var/lib/mysql
innodb_data_file_path           = ibdata1:10M:autoextend
innodb_file_per_table
innodb_buffer_pool_size         = {{ mysql_tuning.innodb_buffer_pool_size }}
innodb_redo_log_capacity        = {{ mysql_tuning.innodb_redo_log_capacity }}
innodb_log_buffer_size          = {{ mysql_tuning.innodb_log_buffer_size }}
innodb_lock_wait_timeout        = 50
innodb_flush_method             = {{ mysql_tuning.innodb_flush_method }}
innodb_flush_log_at_trx_commit  = {{ mysql_tuning.innodb_flush_log_at_trx_commit }}
thread_cache_size               = {{ mysql_tuning.thread_cache_size }}
max_connections                 = {{ mysql_tuning.max_connections }}
max_connect_errors              = {{ mysql_tuning.max_connect_errors }}
max_allowed_packet              = {{ mysql_tuning.max_allowed_packet }}
max_heap_table_size             = {{ mysql_tuning.max_heap_table_size }}
tmp_table_size                  = {{ mysql_tuning.tmp_table_size }}
long_query_time                 = {{ mysql_tuning.long_query_time }}
server-id                       = 1
{% if mysql_tuning.binlog | default(false) | bool %}
sync_binlog                     = 1
log-bin                         = mysql-bin
log-bin-index                   = mysql-bin
binlog_expire_logs_seconds      = 1209600
{% else %}
skip-log-bin
{% endif %}
{% if not (mysql_tuning.mysqlx | default(true) | bool) %}
mysqlx                          = 0
{% endif %}
default_password_lifetime       = 0
log_timestamps                  = SYSTEM
explicit_defaults_for_timestamp

[mysqldump]
quick
max_allowed_packet              = {{ mysql_tuning.max_allowed_packet }}
default-character-set           = utf8mb4
single-transaction

[client]
port                            = 3306
default-character-set           = utf8mb4
socket                          = /var/lib/mysql/mysql.sock
